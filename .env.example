# IMPORTANT: wrap secrets in SINGLE quotes. Bcrypt hashes contain "$" characters
# which Docker Compose would otherwise interpret as variable references.
#
# Bcrypt hash of the shared password. Generate with:
#   python -m app.cli hash-password
APP_PASSWORD_HASH=''

# Random string for signing session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=''

# SQLite database path (relative to working dir or absolute)
DB_PATH=./data/concerts.db

# Optional upper bound on event dates (ISO YYYY-MM-DD). Leave blank to scrape
# everything Songkick has from today onwards (no year limit).
END_DATE=

# Local hour to run the daily scrape (0-23, America/Mexico_City)
SCRAPE_HOUR=4

# Session cookie max age in seconds (default 30 days)
SESSION_MAX_AGE=2592000

# Port for the app (host port mapped in docker-compose)
LISTEN_PORT=8090
